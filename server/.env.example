# Copie a .env y rellene DATABASE_URL (único lugar para credenciales locales).
# cp .env.example .env   (Linux/macOS)  |  copy .env.example .env   (Windows)

JWT_SECRET=replace_with_long_random_secret

# Supabase Session pooler (puerto 6543) — NO usar conexión Direct IPv6 en Fly/local
# Usuario: postgres.[PROJECT_REF]  (ej. postgres.ohwqfujrakhwxfuxo)
# Si la contraseña tiene @ # % / + etc., codifíquela: encodeURIComponent en Node o un encoder URL
# DATABASE_URL=postgres://postgres.ohwqfujrakhwxfuxo:YOUR_URL_ENCODED_PASSWORD@aws-1-us-east-1.pooler.supabase.co:6543/postgres?sslmode=require
DATABASE_URL=

# Solo si DATABASE_URL está vacío (Postgres local)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nexusdoc
DB_USER=postgres
DB_PASS=postgres

# Para migraciones locales contra Supabase, deje NODE_ENV sin definir o use development.
# NODE_ENV=production en .env impide cargar dotenv en algunos scripts; use npm run db:migrate:url

# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173

DB_SYNC_ALTER=false

BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Administrador Maestro

RESEND_API_KEY=
SENDER_EMAIL=verificacion@tu-dominio.com

EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASS=
