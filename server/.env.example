# Local: omit NODE_ENV or use development so dotenv carga este archivo.
# Fly / Docker ya definen NODE_ENV=production y DATABASE_URL vÃ­a secrets.
NODE_ENV=development
JWT_SECRET=replace_with_long_random_secret

# Pegue la URI COMPLETA desde Supabase â†’ Connect â†’ Session pooler (sustituya [YOUR-PASSWORD]).
# Usuario: postgres.SU_PROJECT_REF (NO solo "postgres" en pooler).
# NO copie hosts de ejemplos ajenos (aws-0 vs aws-1 depende de SU proyecto).
# DATABASE_URL=postgres://postgres.SU_REF:PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require&uselibpqcompat=true
DATABASE_URL=

# Solo si DATABASE_URL estÃ¡ vacÃ­o (Postgres local)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nexusdoc
DB_USER=postgres
DB_PASS=postgres

# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173

DB_SYNC_ALTER=false

BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Administrador Maestro

RESEND_API_KEY=
SENDER_EMAIL=verificacion@tu-dominio.com

EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASS=

