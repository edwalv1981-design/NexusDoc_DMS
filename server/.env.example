NODE_ENV=production
JWT_SECRET=replace_with_long_random_secret

# Production DB (Railway / cloud)
DATABASE_URL=postgres://user:password@host:5432/dbname

# Local DB (used only when DATABASE_URL is empty)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nexusdoc
DB_USER=postgres
DB_PASS=postgres

# Comma-separated list of allowed frontend origins.
# Example: http://localhost:5173,https://nexusdoc.example.com
CORS_ORIGINS=http://localhost:5173

# Use true only in controlled development environments.
DB_SYNC_ALTER=false

# Optional bootstrap admin (first deploy only).
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Administrador Maestro

# Email provider (Resend)
RESEND_API_KEY=
SENDER_EMAIL=verificacion@tu-dominio.com

# Legacy SMTP variables (currently not used by code, keep empty)
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASS=
