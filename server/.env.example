JWT_SECRET=replace_with_long_random_secret
DATABASE_URL=postgres://user:password@host:5432/dbname

# Comma-separated list of allowed frontend origins.
# Example: http://localhost:5173,https://nexusdoc.example.com
CORS_ORIGINS=http://localhost:5173

# Use true only in controlled development environments.
DB_SYNC_ALTER=false

# Optional bootstrap admin (first deploy only).
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Administrador Maestro

# Email provider (Resend)
RESEND_API_KEY=
SENDER_EMAIL=verificacion@tu-dominio.com
