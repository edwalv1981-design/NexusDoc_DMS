# Local: omit NODE_ENV or use development so dotenv carga este archivo.
# Fly / Docker ya definen NODE_ENV=production y DATABASE_URL vía secrets.
NODE_ENV=development
JWT_SECRET=replace_with_long_random_secret

# Supabase Session pooler (puerto 6543) — proyecto ohwqfujrakhwxfuxo
# Usuario: postgres.ohwqfujrakhwxfuxo (NO solo "postgres")
# Codifique caracteres especiales de la contraseña en la URL (encodeURIComponent).
# Ejemplo (sustituya YOUR_PASSWORD por la contraseña del dashboard):
# DATABASE_URL=postgres://postgres.ohwqfujrakhwxfuxo:YOUR_PASSWORD@aws-1-us-east-1.pooler.supabase.co:6543/postgres?sslmode=require
DATABASE_URL=postgres://postgres.PROJECT_REF:PASSWORD@aws-1-us-east-1.pooler.supabase.co:6543/postgres?sslmode=require

# Solo si DATABASE_URL está vacío (Postgres local)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nexusdoc
DB_USER=postgres
DB_PASS=postgres

# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173

DB_SYNC_ALTER=false

BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Administrador Maestro

RESEND_API_KEY=
SENDER_EMAIL=verificacion@tu-dominio.com

EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASS=
